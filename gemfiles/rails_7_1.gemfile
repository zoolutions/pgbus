# frozen_string_literal: true

# Rails 7.1 endpoint gemfile.
#
# The gemspec promises `railties >= 7.1, < 9.0`. The main Gemfile floats to the
# latest 8.x, so CI only ever exercises the upper end of that range. This gemfile
# pins the LOWER endpoint (Rails 7.1) so the support claim is proven, not
# aspirational. See issue #284.
#
# Usage:
#   BUNDLE_GEMFILE=gemfiles/rails_7_1.gemfile bundle install
#   BUNDLE_GEMFILE=gemfiles/rails_7_1.gemfile bundle exec rspec spec/pgbus/ spec/generators/ \
#     spec/requests/ spec/rubocop/ spec/benchmarks/ spec/ci_coverage_spec.rb spec/i18n_spec.rb spec/pgbus_spec.rb
#
# The companion lock (rails_7_1.gemfile.lock) is checked in — like the root
# Gemfile.lock — so CI resolves the exact 7.1.x set.

# The main Gemfile reads RAILS_VERSION for its actioncable/activejob/activerecord
# pins. Set it before eval_gemfile so those gems land on 7.1.x too.
ENV["RAILS_VERSION"] ||= "~> 7.1.0"

eval_gemfile File.expand_path("../Gemfile", __dir__)

# Pin the remaining Rails components (pulled in transitively via the gemspec's
# `railties` dep) to the 7.1 series so nothing drags the resolution up to 7.2+.
rails_series = "~> 7.1.0"
gem "actionpack", rails_series
gem "actionview", rails_series
gem "activemodel", rails_series
gem "activesupport", rails_series
gem "railties", rails_series

# rails-i18n tracks the Rails major/minor; its 8.x line requires railties >= 8.
# Pin the 7.x line so the resolver can honor Rails 7.1.
gem "rails-i18n", "~> 7.0"
