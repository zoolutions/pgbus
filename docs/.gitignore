# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# The gem's root .gitignore ignores Gemfile.lock (correct for a gem). But this is
# a real deployable app — commit its lock for reproducible CI + Docker builds.
!Gemfile.lock

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/public/assets

# Node modules + the compiled Tailwind/daisyUI CSS bundle (built in CI/deploy).
/node_modules
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# Generated by bin/build-css (resolved gem @source globs).
/app/assets/stylesheets/tailwind.sources.css
