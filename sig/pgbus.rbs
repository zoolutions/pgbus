# The public surface of pgbus (issue #527). `bundle exec rbs validate` checks
# these files; spec/pgbus/rbs_spec.rb checks they cover the public methods.
module Pgbus
  VERSION: String
  DEAD_LETTER_SUFFIX: String
  DATABASE_TASK_PREFIXES: Array[String]

  class Error < StandardError
  end

  class ConfigurationError < Error
  end

  class SerializationError < Error
  end

  class QueueNotFoundError < Error
  end

  class DeadLetterError < Error
  end

  class ConcurrencyLimitExceeded < Error
  end

  class JobNotUnique < Error
  end

  class SchemaNotReady < Error
  end

  class ReadTimeoutError < Error
  end

  class EnqueueError < Error
  end

  class CurrentAttributesError < Error
  end

  class ExecutionPoolError < Error
  end

  class ConnectionCircuitOpenError < Error
  end

  module Process
    class ReplicaConnectionError < Error
    end
  end

  # Partial: only the types Pgbus.batch names. Batch's own methods are not
  # covered by spec/pgbus/rbs_spec.rb yet.
  class Batch
    class Builder
    end
  end

  # Partial: only the readers a workflow step's guards and body use to see
  # its signal (issue #572), and a step definition's wait_timeout: (issue
  # #574). The rest of Workflow is not covered by spec/pgbus/rbs_spec.rb yet.
  class Workflow
    include Instance

    class Error < Pgbus::Error
    end

    # A step reader (woken?, signal_ready?, ...) called outside a step.
    class NotInStep < Error
    end

    module Instance
      # The Pgbus::WorkflowSignal a wait_for: step took, or nil when its wait timed out.
      def received_signal: () -> untyped
      # The body runs because the wait timed out (on_timeout: :run).
      def timed_out?: () -> bool
      # This attempt holds a signal before its gate: signal! woke it, or an
      # earlier attempt took one and reattempted or paused.
      def woken?: () -> bool
      # The gate runs this attempt with a signal: the held one, or a pending
      # one its wait_for: matcher takes.
      def signal_ready?: () -> bool
    end

    # One declared step (klass.workflow_steps.fetch(:name)): its wait_timeout:.
    class StepDefinition
      # A static wait_timeout: in seconds; nil without one, or for a per-run one.
      def wait_timeout: () -> Numeric?
      # A per-run wait_timeout: as declared: a method name or a lambda.
      def wait_timeout_callable: () -> (Symbol | Proc)?
      # wait_timeout: is a method name or a lambda, evaluated per run.
      def dynamic_wait_timeout?: () -> bool
      # The timeout_at of the step parking at +now+ on +workflow+; nil for no timeout.
      def timeout_at_for: (Workflow workflow, Time now) -> Time?
      # What a per-run wait_timeout: returns on +workflow+: a deadline, seconds from now, or nil.
      def resolve_wait_timeout: (Workflow workflow) -> (Time | Numeric)?
    end
  end

  def self.configuration: () -> Configuration
  def self.configuration_snapshot: () -> Configuration::Snapshot
  def self.configure: () { (Configuration) -> void } -> Configuration
  def self.finalize!: () -> Configuration
  def self.client: () -> Client
  def self.stream: (untyped streamables, ?durable: bool?) -> Streams::Stream
  def self.stream_key: (*untyped parts, ?digest_bits: Integer) -> String
  def self.stream_key!: (String key) -> String
  def self.stream_name_budget: () -> Integer
  # Keywords go to Pgbus::Batch.new (description:, properties:, on_complete:, uniqueness_key:, …).
  def self.batch: (**untyped options) { (Batch::Builder) -> void } -> Batch
  # delay: seconds, as a Numeric or an ActiveSupport::Duration (1.hour).
  def self.publish: (String routing_key, untyped payload, ?headers: Hash[String, untyped]?, ?delay: Numeric | _ToI) -> untyped
  def self.publish_later: (String routing_key, untyped payload, delay: Numeric | _ToI, ?headers: Hash[String, untyped]?) -> untyped
  def self.reset!: () -> void
  def self.reset_client!: () -> void
  def self.stopping: () -> bool
  def self.stopping=: (boolish value) -> bool
  def self.logger: () -> untyped
  def self.logger=: (untyped value) -> untyped
  def self.database_task?: () -> bool
  def self.loader: () -> untyped
  def self.models_loader: () -> untyped
  def self.teardown_models_loader!: () -> void
end
