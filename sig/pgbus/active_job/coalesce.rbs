module Pgbus
  module ActiveJob
    # A unit of work's enqueues, held at the adapter and sent together when
    # the unit ends (issue #682). Opened by Pgbus.coalesce and Middleware.
    class Coalesce
      interface _OnFailure
        def call: (Array[untyped] jobs, Pgbus::EnqueueError error) -> void
      end

      type on_failure = :raise | :report | _OnFailure

      KEY: Symbol
      FAILURE_MODES: Array[Symbol]

      class Result
        attr_reader buffered: Integer
        attr_reader sent: Integer
        attr_reader retried: Integer
        attr_reader failed: Array[untyped]
        attr_reader error: StandardError?

        def initialize: (buffered: Integer, sent: Integer, retried: Integer, failed: Array[untyped], error: StandardError?) -> void
      end

      def self.current: () -> Coalesce?
      # batch_id: (Pgbus.batch, issue #683) a scope of the batch's own that holds only its members;
      # count_in.call(payloads, final:) counts each chunk in before it is sent, the final one closing the build.
      def self.open: [T] (?on_failure: on_failure, ?batch_id: String?, ?count_in: untyped) { () -> T } -> T
      def self.validate_on_failure!: (untyped on_failure) -> void

      attr_reader on_failure: on_failure
      attr_reader batch_id: String?

      def initialize: (?on_failure: on_failure, ?batch_id: String?, ?count_in: untyped, ?chunk_size: Integer) -> void
      def push: (Adapter adapter, untyped job, Hash[String, untyped] payload) -> bool
      def finish!: (?block_error: Exception?) -> Result

      # Runs the request inside Pgbus.coalesce; the buffer is sent before the
      # response tuple is returned.
      class Middleware
        def initialize: (untyped app, ?on_failure: Coalesce::on_failure) -> void
        def call: (Hash[String, untyped] env) -> untyped
      end
    end
  end
end
