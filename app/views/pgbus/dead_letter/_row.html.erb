<%# One dead-letter message plus its expansion row. Locals: m (a
    DataSource#dlq_messages hash), reason (its DeadLetterReason::Result),
    columns. %>
<% payload = pgbus_parse_message(m[:message]) %>
<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50" data-dlq-row="<%= m[:msg_id] %>">
  <td class="w-10 px-4 py-3 align-top">
    <input type="checkbox" data-bulk-item data-pgbus-action="bulk-row-toggle"
           aria-label="<%= t("pgbus.helpers.bulk_select_row", id: m[:msg_id]) %>"
           data-queue-name="<%= m[:queue_name] %>" data-msg-id="<%= m[:msg_id] %>"
           class="h-4 w-4 rounded border-gray-300 text-indigo-600 dark:text-indigo-400 focus:ring-indigo-600 mt-1">
    <input type="hidden" name="messages[][queue_name]" value="<%= m[:queue_name] %>" form="bulk-discard-dlq-form" disabled>
    <input type="hidden" name="messages[][msg_id]" value="<%= m[:msg_id] %>" form="bulk-discard-dlq-form" disabled>
  </td>
  <td data-label="<%= t("pgbus.dead_letter.messages_table.headers.id") %>" class="px-4 py-3 text-sm font-mono text-gray-900 dark:text-white align-top">
    <details data-job-toggle class="group">
      <summary class="cursor-pointer list-none text-indigo-600 hover:text-indigo-800 dark:hover:text-indigo-300 dark:text-indigo-400"><%= m[:msg_id] %></summary>
    </details>
  </td>
  <td data-label="<%= t("pgbus.dead_letter.messages_table.headers.job") %>" class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-white align-top"><%= pgbus_dead_letter_job(m[:message]) %></td>
  <td data-label="<%= t("pgbus.dead_letter.messages_table.headers.source_queue") %>" class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200 align-top"><%= reason.source_queue %></td>
  <td data-label="<%= t("pgbus.dead_letter.messages_table.headers.died") %>" class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400 align-top"><%= pgbus_time(reason.died_at) %></td>
  <td data-label="<%= t("pgbus.dead_letter.messages_table.headers.attempts") %>" class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400 align-top"><%= pgbus_dead_letter_attempts(reason) %></td>
  <td data-label="<%= t("pgbus.dead_letter.messages_table.headers.reason") %>" class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200 align-top" data-testid="dlq-reason">
    <%= pgbus_dead_letter_reason(reason, filter_path: @list_path) %>
  </td>
  <td data-label="<%= t("pgbus.dead_letter.messages_table.headers.actions") %>" class="px-4 py-3 text-sm text-right align-top">
    <div class="flex justify-end space-x-2">
      <%= pgbus_button_to t("pgbus.dead_letter.messages_table.retry"), pgbus.retry_dead_letter_path(m[:msg_id], queue_name: m[:queue_name]), method: :post,
            variant: :link, size: :sm,
            data: { turbo_frame: "_top" } %>
      <%= pgbus_button_to t("pgbus.dead_letter.messages_table.discard"), pgbus.discard_dead_letter_path(m[:msg_id], queue_name: m[:queue_name]), method: :post,
            variant: :link, size: :sm, tone: :red,
            data: { turbo_confirm: t("pgbus.dead_letter.messages_table.discard_confirm"), turbo_frame: "_top" } %>
    </div>
  </td>
</tr>
<tr class="pgbus-job-detail" data-job-detail data-dlq-detail="<%= m[:msg_id] %>">
  <td colspan="<%= columns %>" class="px-4 pb-4 bg-gray-50 dark:bg-gray-900 border-t border-gray-100 dark:border-gray-700">
    <div class="flex items-center justify-between mt-3 mb-3">
      <span class="text-xs font-mono text-gray-500 dark:text-gray-400"><%= t("pgbus.dead_letter.messages_table.job_id") %> <%= payload["job_id"] || payload["event_id"] || "—" %></span>
      <%= pgbus_link_to t("pgbus.dead_letter.messages_table.view"), pgbus.dead_letter_path(m[:msg_id], queue_name: m[:queue_name]),
            size: :sm, data: { turbo_frame: "_top" } %>
    </div>
    <%= render "pgbus/dead_letter/error", reason: reason %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-3">
      <div>
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.dead_letter.messages_table.arguments") %></span>
        <pre class="text-xs text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 rounded p-2 mt-1 overflow-x-auto max-h-40"><%= JSON.pretty_generate(payload["arguments"] || payload["payload"] || []) rescue "—" %></pre>
      </div>
      <div>
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.dead_letter.messages_table.metadata") %></span>
        <div class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 rounded p-2 mt-1 space-y-1">
          <p><strong><%= t("pgbus.dead_letter.detail.dlq") %></strong> <%= m[:queue_name] %></p>
          <% if reason.source %><p><strong><%= t("pgbus.dead_letter.detail.source") %></strong> <%= t("pgbus.dead_letter.detail.sources.#{reason.source}", default: reason.source) %></p><% end %>
          <p><strong><%= t("pgbus.dead_letter.detail.died") %></strong> <%= pgbus_timestamp(reason.died_at) %></p>
          <% if payload["queue_name"] %><p><strong><%= t("pgbus.dead_letter.messages_table.metadata_labels.queue") %></strong> <%= payload["queue_name"] %></p><% end %>
          <% if payload["priority"] %><p><strong><%= t("pgbus.dead_letter.messages_table.metadata_labels.priority") %></strong> <%= payload["priority"] %></p><% end %>
          <% if payload["executions"] %><p><strong><%= t("pgbus.dead_letter.messages_table.metadata_labels.executions") %></strong> <%= payload["executions"] %></p><% end %>
          <% if m[:vt] %><p><strong><%= t("pgbus.dead_letter.messages_table.metadata_labels.visible_at") %></strong> <%= pgbus_timestamp(m[:vt]) %></p><% end %>
          <% if m[:last_read_at] %><p><strong><%= t("pgbus.dead_letter.messages_table.metadata_labels.last_read") %></strong> <%= pgbus_timestamp(m[:last_read_at]) %></p><% end %>
        </div>
      </div>
    </div>
    <details class="mt-2">
      <summary class="text-xs font-medium text-gray-500 dark:text-gray-400 cursor-pointer hover:text-gray-700 dark:hover:text-gray-200"><%= t("pgbus.dead_letter.messages_table.full_json_payload") %></summary>
      <pre class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 rounded p-2 mt-1 overflow-x-auto max-h-96"><%= JSON.pretty_generate(payload) rescue m[:message] %></pre>
    </details>
    <% if m[:headers] %>
      <details class="mt-2">
        <summary class="text-xs font-medium text-gray-500 dark:text-gray-400 cursor-pointer hover:text-gray-700 dark:hover:text-gray-200"><%= t("pgbus.dead_letter.messages_table.headers_section") %></summary>
        <pre class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 rounded p-2 mt-1 overflow-x-auto"><%= JSON.pretty_generate(JSON.parse(m[:headers])) rescue m[:headers] %></pre>
      </details>
    <% end %>
  </td>
</tr>
