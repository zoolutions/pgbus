<%# Dead-letter list (issue #495). Every row says why the message died, read
    from the pgbus_dead_letter header block by DeadLetterReason; a row's
    expansion is the <tr> after it, shown by CSS (.pgbus-job-detail in
    tailwind.css) while the ID cell's <details> is open, like the Jobs list.
    @list_path (->(extra) { url }) carries the dlq/error_class filters into
    the frame source, the chips and the pager. %>
<% columns = @messages.any? ? 8 : 7 %>
<turbo-frame id="dlq-messages" data-auto-refresh data-src="<%= @list_path.call(frame: "list", page: (@page if @page > 1)) %>">
  <nav class="mb-4 flex flex-wrap items-center gap-2" aria-label="<%= t("pgbus.dead_letter.filters.label") %>" data-testid="dlq-filters">
    <% [nil, *@dlq_counts.keys].each do |name| %>
      <% active = name == @dlq %>
      <a href="<%= @list_path.call(dlq: name, page: nil) %>" data-turbo-frame="_top"
         aria-current="<%= active ? "page" : "false" %>"
         class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium <%= active ? 'bg-gray-800 text-white dark:bg-gray-700' : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white' %>">
        <span><%= name || t("pgbus.dead_letter.filters.all") %></span>
        <span class="rounded-full px-2 py-0.5 text-xs <%= active ? 'bg-gray-600 text-white' : 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200' %>"><%= number_with_delimiter(name ? @dlq_counts[name] : @dlq_counts.values.sum) %></span>
      </a>
    <% end %>
    <% if @error_class %>
      <span class="inline-flex items-center gap-2 rounded-md bg-red-50 dark:bg-red-900/30 px-3 py-1 text-sm text-red-800 dark:text-red-200" data-testid="dlq-error-filter">
        <%= t("pgbus.dead_letter.filters.error_class", error_class: @error_class) %>
        <%= pgbus_link_to t("pgbus.dead_letter.filters.clear_error_class"), @list_path.call(error_class: nil, page: nil),
              size: :sm, tone: :red, data: { turbo_frame: "_top" } %>
      </span>
    <% end %>
  </nav>
  <%# Count badge lives inside the frame so it refreshes in lockstep with the table. %>
  <% if @total_count && @total_count > 0 %>
    <p class="mb-3 text-sm text-gray-500 dark:text-gray-400">
      <span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900 px-2.5 py-0.5 text-sm font-medium text-red-800 dark:text-red-200"><%= @total_count %></span>
      <%= t("pgbus.dead_letter.messages_table.total_label") %>
    </p>
  <% end %>
  <%# Bulk form outside table to avoid nested form issues %>
  <form id="bulk-discard-dlq-form" action="<%= pgbus.discard_selected_dead_letter_index_path %>" method="post" data-turbo-frame="_top" class="hidden">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  </form>
  <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700" data-bulk-scope="dlq">
    <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900">
        <tr>
          <% if @messages.any? %>
            <th class="w-10 px-4 py-3">
              <input type="checkbox" data-bulk-select-all
                     aria-label="<%= t("pgbus.helpers.bulk_select_all") %>"
                     class="h-4 w-4 rounded border-gray-300 text-indigo-600 dark:text-indigo-400 focus:ring-indigo-600">
            </th>
          <% end %>
          <% %w[id job source_queue died attempts reason].each do |header| %>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dead_letter.messages_table.headers.#{header}") %></th>
          <% end %>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dead_letter.messages_table.headers.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @dlq_rows.each do |m, reason| %>
          <%= render "pgbus/dead_letter/row", m: m, reason: reason, columns: columns %>
        <% end %>
        <% if @messages.empty? %>
          <%# No rows means no checkbox column. %>
          <%= render "pgbus/shared/empty_row", colspan: columns, message: t("pgbus.dead_letter.messages_table.empty") %>
        <% end %>
      </tbody>
    </table>
    <%= render "pgbus/shared/pager", page: @page, per_page: @per_page, shown: @messages.size, total_count: @total_count.to_i,
          page_path: ->(n) { @list_path.call(page: n) } %>
  </div>
</turbo-frame>
