<turbo-frame id="recurring-tasks" data-auto-refresh data-src="<%= pgbus.recurring_tasks_path(frame: 'recurring_tasks') %>">
  <div class="rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700">
    <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.recurring_tasks.tasks_table.headers.task") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.recurring_tasks.tasks_table.headers.schedule") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.recurring_tasks.tasks_table.headers.queue") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.recurring_tasks.tasks_table.headers.last_run") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.recurring_tasks.tasks_table.headers.next_run") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.recurring_tasks.tasks_table.headers.status") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.recurring_tasks.tasks_table.headers.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @recurring_tasks.each do |task| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
            <td data-label="<%= t("pgbus.recurring_tasks.tasks_table.headers.task") %>" class="px-4 py-3">
              <div>
                <%= pgbus_link_to task[:key], pgbus.recurring_task_path(task[:id]), data: { turbo_frame: "_top" } %>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400"><%= task[:class_name] || task[:command]&.truncate(40) %></div>
              <% if task[:description] %>
                <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= task[:description] %></div>
              <% end %>
            </td>
            <td data-label="<%= t("pgbus.recurring_tasks.tasks_table.headers.schedule") %>" class="px-4 py-3">
              <div class="text-sm text-gray-900 dark:text-white"><%= task[:schedule] %></div>
              <% if task[:human_schedule] && task[:human_schedule] != task[:schedule] %>
                <div class="text-xs text-gray-500 dark:text-gray-400"><%= task[:human_schedule] %></div>
              <% end %>
            </td>
            <td data-label="<%= t("pgbus.recurring_tasks.tasks_table.headers.queue") %>" class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
              <%= task[:queue_name] || t("pgbus.recurring_tasks.tasks_table.default_queue") %>
            </td>
            <td data-label="<%= t("pgbus.recurring_tasks.tasks_table.headers.last_run") %>" class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
              <%= task[:last_run_at] ? pgbus_time_ago(task[:last_run_at]) : t("pgbus.recurring_tasks.tasks_table.never") %>
            </td>
            <td data-label="<%= t("pgbus.recurring_tasks.tasks_table.headers.next_run") %>" class="px-4 py-3 text-sm text-gray-600 dark:text-gray-300">
              <% if task[:enabled] && task[:next_run_at] %>
                <%= pgbus_time_ago_future(task[:next_run_at]) %>
              <% else %>
                <span class="text-gray-500 dark:text-gray-400">—</span>
              <% end %>
            </td>
            <td data-label="<%= t("pgbus.recurring_tasks.tasks_table.headers.status") %>" class="px-4 py-3">
              <% if task[:enabled] %>
                <%= pgbus_recurring_health_badge(task) %>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:text-gray-300">
                  <%= t("pgbus.recurring_tasks.tasks_table.disabled") %>
                </span>
              <% end %>
            </td>
            <td data-label="<%= t("pgbus.recurring_tasks.tasks_table.headers.actions") %>" class="px-4 py-3 text-right space-x-1">
              <%= pgbus_button_to task[:enabled] ? t("pgbus.recurring_tasks.tasks_table.disable") : t("pgbus.recurring_tasks.tasks_table.enable"),
                  pgbus.toggle_recurring_task_path(task[:id]),
                  variant: task[:enabled] ? :warning : :success, size: :sm %>
              <% if task[:enabled] %>
                <%= pgbus_button_to t("pgbus.recurring_tasks.tasks_table.run_now"),
                    pgbus.enqueue_recurring_task_path(task[:id]), variant: :primary, size: :sm %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @recurring_tasks.empty? %>
          <%= render "pgbus/shared/empty_row", colspan: 7,
                message: safe_join([content_tag(:p, t("pgbus.recurring_tasks.tasks_table.empty_title"), class: "text-lg font-medium"),
                                    content_tag(:p, t("pgbus.recurring_tasks.tasks_table.empty_hint"), class: "mt-1")]) %>
        <% end %>
      </tbody>
    </table>
  </div>
</turbo-frame>
