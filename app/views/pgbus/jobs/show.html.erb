<div class="mb-6">
  <%= pgbus_link_to "\u2190 #{t("pgbus.jobs.show.back")}", pgbus.jobs_path %>
</div>

<% if @job %>
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6"><%= t("pgbus.jobs.show.title", id: @job["id"]) %></h1>

  <div class="rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700 p-6 mb-6">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.jobs.show.labels.queue") %></dt>
        <dd class="text-sm text-gray-900 dark:text-white"><%= @job["queue_name"] %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.jobs.show.labels.failed_at") %></dt>
        <dd class="text-sm text-gray-900 dark:text-white"><%= pgbus_timestamp(@job["failed_at"]) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.jobs.show.labels.error_class") %></dt>
        <dd class="text-sm text-red-600 dark:text-red-400 font-medium"><%= @job["error_class"] %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.jobs.show.labels.retry_count") %></dt>
        <dd class="text-sm text-gray-900 dark:text-white"><%= @job["retry_count"] %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700 p-6 mb-6">
    <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2"><%= t("pgbus.jobs.show.error_message") %></h2>
    <p class="text-sm text-red-700 dark:text-red-400"><%= @job["error_message"] %></p>
  </div>

  <% if @job["backtrace"].present? %>
    <div class="rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700 p-6 mb-6">
      <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2"><%= t("pgbus.jobs.show.backtrace") %></h2>
      <pre class="text-xs text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-900 rounded p-4 overflow-x-auto max-h-96"><%= @job["backtrace"] %></pre>
    </div>
  <% end %>

  <% if (context = pgbus_job_context(@job["payload"])) %>
    <div class="rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700 p-6 mb-6" data-testid="job-context">
      <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2"><%= t("pgbus.jobs.show.context") %></h2>
      <% context.each do |klass_name, attrs| %>
        <h3 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mt-3 mb-1 font-mono"><%= klass_name %></h3>
        <dl class="grid grid-cols-1 gap-x-4 gap-y-1 sm:grid-cols-2">
          <% attrs.each do |name, value| %>
            <div class="flex gap-2 text-xs">
              <dt class="text-gray-500 dark:text-gray-400 font-mono"><%= name %></dt>
              <dd class="text-gray-900 dark:text-white font-mono break-all"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700 p-6 mb-6">
    <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2"><%= t("pgbus.jobs.show.payload") %></h2>
    <pre class="text-xs text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-900 rounded p-4 overflow-x-auto"><%= JSON.pretty_generate(pgbus_parse_message(@job["payload"])) %></pre>
  </div>

  <div class="flex space-x-2">
    <%= pgbus_button_to t("pgbus.jobs.show.retry"), pgbus.retry_job_path(@job["id"]), method: :post, variant: :primary %>
    <%= pgbus_button_to t("pgbus.jobs.show.discard"), pgbus.discard_job_path(@job["id"]), method: :post, variant: :danger,
          data: { turbo_confirm: t("pgbus.jobs.show.discard_confirm") } %>
  </div>
<% else %>
  <div class="text-center py-12">
    <p class="text-gray-500 dark:text-gray-400"><%= t("pgbus.jobs.show.not_found") %></p>
  </div>
<% end %>
