<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("pgbus.jobs.index.title") %></h1>
  <div class="flex space-x-2">
    <%# Retry All / Discard All act on failed events in every queue, not just a filtered one. %>
    <% if @failed_total.positive? %>
      <%= pgbus_button_to t("pgbus.jobs.index.retry_all"), pgbus.retry_all_jobs_path, method: :post, variant: :primary,
            data: { turbo_confirm: t("pgbus.jobs.index.retry_all_confirm") } %>
      <%= pgbus_button_to t("pgbus.jobs.index.discard_all"), pgbus.discard_all_jobs_path, method: :post, variant: :danger,
            data: { turbo_confirm: t("pgbus.jobs.index.discard_all_confirm") } %>
    <% end %>
  </div>
</div>

<nav class="mb-4 flex flex-wrap gap-2" aria-label="<%= t("pgbus.jobs.list.tabs_label") %>" data-testid="job-state-tabs">
  <% Pgbus::JobsController::STATES.each do |state| %>
    <% active = state == @state %>
    <a href="<%= pgbus.jobs_path(state: (state unless state == "all"), queue: @queue) %>"
       data-state="<%= state %>" aria-current="<%= active ? "page" : "false" %>"
       class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium <%= active ? 'bg-gray-800 text-white dark:bg-gray-700' : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white' %>">
      <span><%= t("pgbus.jobs.list.tabs.#{state}") %></span>
      <span class="rounded-full px-2 py-0.5 text-xs <%= active ? 'bg-gray-600 text-white' : 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-200' %>"><%= pgbus_job_count(@counts, state) %></span>
    </a>
  <% end %>
</nav>

<%= render "pgbus/jobs/list" %>
