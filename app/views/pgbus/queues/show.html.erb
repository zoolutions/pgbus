<div class="mb-3">
  <%= pgbus_link_to "← #{t("pgbus.queues.show.back")}", pgbus.queues_path %>
</div>
<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
      <%= @queue&.dig(:name) || params[:name] %>
      <%= pgbus_paused_badge(@paused) %>
    </h1>
  </div>
  <div class="flex space-x-2">
    <% if @paused %>
      <%= pgbus_button_to t("pgbus.queues.show.resume"), pgbus.resume_queue_path(name: params[:name]),
            method: :post, variant: :success %>
    <% else %>
      <%= pgbus_button_to t("pgbus.queues.show.pause"), pgbus.pause_queue_path(name: params[:name]),
            method: :post, variant: :warning,
            data: { turbo_confirm: t("pgbus.queues.show.pause_confirm") } %>
    <% end %>
    <%= pgbus_button_to t("pgbus.queues.show.purge_queue"), pgbus.purge_queue_path(name: params[:name]),
          method: :post, variant: :danger,
          data: { turbo_confirm: t("pgbus.queues.show.purge_confirm") } %>
    <%= pgbus_button_to t("pgbus.queues.show.delete_queue"), pgbus.queue_path(name: params[:name]),
          method: :delete, variant: :destructive,
          data: { turbo_confirm: t("pgbus.queues.show.delete_confirm") } %>
  </div>
</div>

<%# The queue in words (Pgbus::Web::QueueSummary), then its numbers. %>
<section aria-label="<%= t("pgbus.queues.show.summary_label") %>" data-testid="queue-summary" class="mb-6 space-y-2">
  <% @summary.each do |line| %>
    <p data-summary-line="<%= line.key %>" class="rounded-md px-3 py-2 text-sm ring-1 <%= pgbus_queue_summary_classes(line.tone) %>"><%= pgbus_queue_summary_line(line) %></p>
  <% end %>
  <% if @drainers[:siblings].any? %>
    <p class="text-sm text-gray-700 dark:text-gray-200">
      <%= t("pgbus.queues.show.other_levels") %>
      <% @drainers[:siblings].each do |sibling| %>
        <%= pgbus_link_to sibling, pgbus.queue_path(name: sibling), size: :sm, class: "font-mono" %>
      <% end %>
    </p>
  <% end %>
</section>

<dl data-testid="queue-metrics" class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
  <% [[:depth, pgbus_number(@queue[:queue_length])],
      [:claimable, pgbus_number(@queue[:queue_visible_length])],
      [:parked, pgbus_number(@queue[:parked_length])],
      [:oldest_claimable, pgbus_duration(@queue[:oldest_claimable_age_sec])],
      [:oldest, pgbus_duration(@queue[:oldest_msg_age_sec])],
      [:total, pgbus_number(@queue[:total_messages])]].each do |key, value| %>
    <div class="rounded-lg bg-white dark:bg-gray-800 px-4 py-3 shadow ring-1 ring-gray-200 dark:ring-gray-700">
      <dt class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.queues.show.metrics.#{key}") %></dt>
      <dd class="mt-1 text-lg font-semibold font-mono text-gray-900 dark:text-white"><%= value %></dd>
    </div>
  <% end %>
</dl>

<!-- Table Health -->
<% if @health && @health[:tables].any? %>
  <div class="mb-6 overflow-hidden rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700">
    <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-700">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("pgbus.queues.show.table_health.title") %></h2>
      <% if @health[:oldest_transaction_age_sec] %>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
          <%= t("pgbus.queues.show.table_health.oldest_txn") %>
          <span class="font-mono <%= @health[:oldest_transaction_age_sec] > 60 ? 'text-red-600 dark:text-red-400' : @health[:oldest_transaction_age_sec] > 30 ? 'text-amber-700 dark:text-amber-400' : 'text-green-700 dark:text-green-400' %>"><%= pgbus_duration(@health[:oldest_transaction_age_sec]) %></span>
        </p>
      <% end %>
    </div>
    <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.queues.show.table_health.headers.table") %></th>
          <th class="px-4 py-2 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.queues.show.table_health.headers.live") %></th>
          <th class="px-4 py-2 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.queues.show.table_health.headers.dead") %></th>
          <th class="px-4 py-2 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.queues.show.table_health.headers.bloat") %></th>
          <th class="px-4 py-2 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.queues.show.table_health.headers.last_vacuum") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% @health[:tables].each do |t| %>
          <tr>
            <td data-label="<%= t("pgbus.queues.show.table_health.headers.table") %>" class="px-4 py-2 text-sm font-mono text-gray-900 dark:text-white"><%= t[:table] %></td>
            <td data-label="<%= t("pgbus.queues.show.table_health.headers.live") %>" class="px-4 py-2 text-sm text-right text-gray-700 dark:text-gray-300"><%= pgbus_number(t[:live_tuples]) %></td>
            <td data-label="<%= t("pgbus.queues.show.table_health.headers.dead") %>" class="px-4 py-2 text-sm text-right <%= t[:dead_tuples] > 1000 ? 'text-amber-700 dark:text-amber-400 font-semibold' : 'text-gray-700 dark:text-gray-300' %>"><%= pgbus_number(t[:dead_tuples]) %></td>
            <td data-label="<%= t("pgbus.queues.show.table_health.headers.bloat") %>" class="px-4 py-2 text-sm text-right <%= t[:bloat_ratio] > 0.2 ? 'text-red-600 dark:text-red-400 font-semibold' : t[:bloat_ratio] > 0.1 ? 'text-amber-700 dark:text-amber-400' : 'text-gray-500 dark:text-gray-400' %>"><%= (t[:bloat_ratio] * 100).round(1) %>%</td>
            <td data-label="<%= t("pgbus.queues.show.table_health.headers.last_vacuum") %>" class="px-4 py-2 text-sm text-right text-gray-500 dark:text-gray-400"><%= t[:last_vacuum_ago_sec] ? pgbus_duration(t[:last_vacuum_ago_sec]) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @dlq %>
  <%# DLQ tables are not part of the unified list; their messages live on the Dead Letter page. %>
  <div data-testid="dlq-pointer" class="rounded-lg bg-white dark:bg-gray-800 px-4 py-4 shadow ring-1 ring-gray-200 dark:ring-gray-700">
    <p class="text-sm text-gray-700 dark:text-gray-200">
      <%= t("pgbus.queues.show.dlq_pointer", logical: @drainers[:logical], count: @queue[:queue_length].to_i) %>
      <%= pgbus_link_to t("pgbus.queues.show.dlq_link"), pgbus.dead_letter_index_path(dlq: params[:name]), size: :sm %>
    </p>
  </div>
<% else %>
  <%# Scoped to this physical table. Known wart: blocked rows match the
      logical name too, so a queue's blocked jobs show on every _pN page
      (they are parked before a priority level is chosen). %>
  <%= render "pgbus/jobs/tabs", state: @state, counts: @counts, list_path: @list_path %>
  <%= render "pgbus/jobs/list" %>
<% end %>
