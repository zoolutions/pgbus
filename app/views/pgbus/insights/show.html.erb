<%# The chart series, embedded once (issue #492): charts.js reads them here
    instead of fetching /pgbus/api/insights. json_escape keeps a value from
    closing the tag; a data block needs no nonce. %>
<%= tag.script(json_escape(@chart_payload.to_json).html_safe, type: "application/json", id: "pgbus-insights-data") %> <%# herb:disable erb-no-unsafe-raw %>

<script type="module" nonce="<%= content_security_policy_nonce %>">
  import { renderCharts, observeThemeChanges } from "charts";

  const i18n = <%= json_escape(pgbus_chart_i18n.to_json).html_safe %>;
  const data = JSON.parse(document.getElementById("pgbus-insights-data").textContent);

  renderCharts(data, i18n);
  observeThemeChanges(() => data, i18n);
</script>
