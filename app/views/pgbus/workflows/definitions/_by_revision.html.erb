<%# The numbers per app revision (issue #549): the last five revisions that
    finished an attempt in the window, newest first, each with its totals and
    its steps. A failure rate more than five points above the same row on the
    revision before says so. Locals: definition. %>
<% revisions = definition[:by_revision] %>
<section class="mb-8" aria-labelledby="workflow-by-revision-title">
  <h2 id="workflow-by-revision-title" class="text-lg font-medium text-gray-900 dark:text-white"><%= t("pgbus.workflow_insights.show.by_revision.title") %></h2>
  <p class="mt-1 text-sm text-gray-600 dark:text-gray-300"><%= t("pgbus.workflow_insights.show.by_revision.caption") %></p>
  <div class="mt-3 rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700" data-testid="workflow-by-revision">
    <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.by_revision.headers.revision") %></th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.by_revision.headers.step") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.by_revision.headers.attempts") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.by_revision.headers.failed") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.by_revision.headers.reattempted") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.by_revision.headers.skipped") %></th>
          <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.by_revision.headers.run_time") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% revisions.each_with_index do |revision, index| %>
          <% [nil, *revision[:steps]].each do |step| %>
            <% row = step || revision %>
            <% worse = pgbus_insight_worse(revisions, index, step) %>
            <tr data-revision="<%= revision[:revision] %>" data-step="<%= step ? step[:name] : "" %>" class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td data-label="<%= t("pgbus.workflow_insights.show.by_revision.headers.revision") %>" class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">
                <code class="font-mono text-gray-900 dark:text-white"><%= revision[:revision] %></code>
                <% unless step %>
                  <span class="block text-xs text-gray-600 dark:text-gray-300"><%= t("pgbus.workflow_insights.show.by_revision.seen_html", from: pgbus_time(revision[:first_seen_at]), to: pgbus_time(revision[:last_seen_at])) %></span>
                <% end %>
              </td>
              <td data-label="<%= t("pgbus.workflow_insights.show.by_revision.headers.step") %>" class="px-4 py-3 text-sm <%= step ? 'font-mono text-gray-700 dark:text-gray-300' : 'font-medium text-gray-900 dark:text-white' %>"><%= step ? step[:name] : t("pgbus.workflow_insights.show.by_revision.all_steps") %></td>
              <td data-label="<%= t("pgbus.workflow_insights.show.by_revision.headers.attempts") %>" class="px-4 py-3 text-sm text-right font-mono text-gray-700 dark:text-gray-300"><%= pgbus_number(row[:attempts]) %></td>
              <td data-label="<%= t("pgbus.workflow_insights.show.by_revision.headers.failed") %>" class="px-4 py-3 text-sm text-right font-mono <%= worse ? 'text-red-700 dark:text-red-300' : 'text-gray-700 dark:text-gray-300' %>">
                <%= pgbus_insight_rate(row[:rates][:failed]) %>
                <% if worse %><span class="block text-xs"><%= worse %></span><% end %>
              </td>
              <td data-label="<%= t("pgbus.workflow_insights.show.by_revision.headers.reattempted") %>" class="px-4 py-3 text-sm text-right font-mono text-gray-700 dark:text-gray-300"><%= pgbus_insight_rate(row[:rates][:reattempted]) %></td>
              <td data-label="<%= t("pgbus.workflow_insights.show.by_revision.headers.skipped") %>" class="px-4 py-3 text-sm text-right font-mono text-gray-700 dark:text-gray-300"><%= pgbus_insight_rate(row[:rates][:skipped]) %></td>
              <td data-label="<%= t("pgbus.workflow_insights.show.by_revision.headers.run_time") %>" class="px-4 py-3 text-sm text-right font-mono text-gray-700 dark:text-gray-300"><%= pgbus_insight_percentiles(row[:run_ms], %i[p50 p95]) %></td>
            </tr>
          <% end %>
        <% end %>
        <% if revisions.empty? %>
          <%= render "pgbus/shared/empty_row", colspan: 7, message: t("pgbus.workflow_insights.show.by_revision.empty") %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
