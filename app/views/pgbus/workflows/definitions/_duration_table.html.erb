<%# The duration chart's data table (issue #549): the finished runs per
    end-to-end duration range. Locals: definition. %>
<table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
  <thead class="bg-gray-50 dark:bg-gray-900">
    <tr>
      <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.charts.durations.headers.range") %></th>
      <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflow_insights.show.charts.durations.headers.runs") %></th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
    <% definition[:duration_histogram].each do |bin| %>
      <tr>
        <td data-label="<%= t("pgbus.workflow_insights.show.charts.durations.headers.range") %>" class="px-4 py-2 text-sm text-gray-700 dark:text-gray-300"><%= pgbus_insight_bin_label(bin) %></td>
        <td data-label="<%= t("pgbus.workflow_insights.show.charts.durations.headers.runs") %>" class="px-4 py-2 text-sm text-right font-mono text-gray-700 dark:text-gray-300"><%= pgbus_number(bin[:count]) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
