<%# The needs-attention view (issue #542): every ongoing run with a stuck
    reason, grouped by (class, step, reason, error class). Each group has bulk
    Resume and Cancel (as its runs' status allows) with an optional reason,
    and a link to the filtered list. Not auto-refreshed: a typed reason stays. %>
<div class="flex flex-wrap items-start justify-between gap-4 mb-6">
  <div>
    <div class="mb-2"><%= pgbus_link_to t("pgbus.workflows.attention.back"), pgbus.workflows_path %></div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("pgbus.workflows.attention.title") %></h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("pgbus.workflows.attention.description") %></p>
  </div>
</div>

<div class="rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700">
  <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
    <thead class="bg-gray-50 dark:bg-gray-900">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflows.attention.headers.workflow") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflows.attention.headers.reason") %></th>
        <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflows.attention.headers.runs") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflows.attention.headers.seen") %></th>
        <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.workflows.attention.headers.actions") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
      <% @groups.each_with_index do |group, index| %>
        <% actions = group[:available_actions] & %i[resume cancel] %>
        <% list_query = { status: group[:status], workflow_class: group[:workflow_class], step: group[:step_name], error_class: group[:error_class] }.compact %>
        <tr data-reason="<%= group[:reason] %>" class="align-top hover:bg-gray-50 dark:hover:bg-gray-700/50">
          <td data-label="<%= t("pgbus.workflows.attention.headers.workflow") %>" class="px-4 py-3 text-sm text-gray-900 dark:text-white">
            <span class="block font-medium"><%= group[:workflow_class] %></span>
            <span class="block text-xs text-gray-600 dark:text-gray-300"><%= t("pgbus.workflows.attention.at_step_html", step: tag.code(group[:step_name], class: "font-mono")) %></span>
          </td>
          <td data-label="<%= t("pgbus.workflows.attention.headers.reason") %>" class="px-4 py-3 text-sm max-w-md">
            <span class="block text-gray-900 dark:text-white"><%= t("pgbus.workflows.attention.reasons.#{group[:reason]}") %></span>
            <% if group[:error_class] %>
              <span class="mt-1 block font-mono text-xs text-red-700 dark:text-red-300"><%= group[:error_class] %></span>
            <% end %>
            <% if group[:error_message].present? %>
              <span class="block text-xs text-gray-700 dark:text-gray-300 break-words"><%= group[:error_message] %></span>
            <% end %>
          </td>
          <td data-label="<%= t("pgbus.workflows.attention.headers.runs") %>" class="px-4 py-3 text-right font-mono text-sm text-gray-900 dark:text-white"><%= number_with_delimiter(group[:count]) %></td>
          <td data-label="<%= t("pgbus.workflows.attention.headers.seen") %>" class="px-4 py-3 text-xs text-gray-600 dark:text-gray-300">
            <span class="block"><%= t("pgbus.workflows.attention.first_seen_html", time: pgbus_time(group[:first_seen_at])) %></span>
            <span class="block"><%= t("pgbus.workflows.attention.last_seen_html", time: pgbus_time(group[:last_seen_at])) %></span>
          </td>
          <td data-label="<%= t("pgbus.workflows.attention.headers.actions") %>" class="px-4 py-3 text-sm">
            <% if actions.any? %>
              <form action="<%= pgbus.bulk_cancel_workflows_path %>" method="post" data-turbo-frame="_top" class="space-y-2">
                <%= hidden_field_tag :authenticity_token, form_authenticity_token, id: nil %>
                <% Pgbus::WorkflowsController::GROUP_FIELDS.each do |field| %>
                  <input type="hidden" name="group[<%= field %>]" value="<%= group[field] %>">
                <% end %>
                <label for="attention-reason-<%= index %>" class="block text-xs font-medium text-gray-700 dark:text-gray-300"><%= t("pgbus.workflows.show.reason_label") %></label>
                <input type="text" autocomplete="off" id="attention-reason-<%= index %>" name="reason" maxlength="1000" class="<%= Pgbus::WorkflowsHelper::INPUT_CSS %>">
                <div class="flex flex-wrap gap-2">
                  <% if actions.include?(:resume) %>
                    <%= pgbus_button_tag t("pgbus.workflows.attention.resume_all", count: group[:count]), variant: :success, size: :sm,
                          formaction: pgbus.bulk_resume_workflows_path, confirm: pgbus_workflow_bulk_confirm(:resume, group) %>
                  <% end %>
                  <% if actions.include?(:cancel) %>
                    <%= pgbus_button_tag t("pgbus.workflows.attention.cancel_all", count: group[:count]), variant: :danger, size: :sm,
                          formaction: pgbus.bulk_cancel_workflows_path, confirm: pgbus_workflow_bulk_confirm(:cancel, group) %>
                  <% end %>
                </div>
              </form>
            <% end %>
            <div class="mt-2"><%= pgbus_link_to t("pgbus.workflows.attention.show_runs"), pgbus.workflows_path(list_query), size: :sm %></div>
          </td>
        </tr>
      <% end %>
      <% if @groups.empty? %>
        <%= render "pgbus/shared/empty_row", colspan: 5,
              message: safe_join([content_tag(:p, t("pgbus.workflows.attention.empty_title"), class: "text-lg font-medium"),
                                  content_tag(:p, t("pgbus.workflows.attention.empty_hint"), class: "mt-1")]) %>
      <% end %>
    </tbody>
  </table>
</div>
