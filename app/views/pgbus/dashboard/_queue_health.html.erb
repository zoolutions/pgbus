<turbo-frame id="dashboard-health" data-auto-refresh data-src="<%= pgbus.root_path(frame: 'health') %>">
  <% verdict = Pgbus::Web::HealthVerdict.present(@health) %>
  <div class="mb-8">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("pgbus.dashboard.queue_health.title") %></h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-4">
      <div class="rounded-lg bg-white dark:bg-gray-800 p-5 shadow ring-1 ring-gray-200 dark:ring-gray-700">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.dead_tuples") %></p>
        <p class="<%= pgbus_health_number_css(verdict.dead_tuples) %>"><%= pgbus_number(@health[:total_dead_tuples]) %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= pgbus_number(@health[:total_live_tuples]) %> <%= t("pgbus.dashboard.queue_health.live") %></p>
        <%= pgbus_health_words(verdict.dead_tuples) %>
      </div>

      <div class="rounded-lg bg-white dark:bg-gray-800 p-5 shadow ring-1 ring-gray-200 dark:ring-gray-700">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.worst_bloat") %></p>
        <p class="<%= pgbus_health_number_css(verdict.bloat) %>"><%= pgbus_percent(@health[:worst_bloat_ratio]) %></p>
        <% if @health[:tables_needing_vacuum] > 0 %>
          <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.tables_need_vacuum", count: @health[:tables_needing_vacuum]) %></p>
        <% end %>
        <%= pgbus_health_words(verdict.bloat) %>
      </div>

      <div class="rounded-lg bg-white dark:bg-gray-800 p-5 shadow ring-1 ring-gray-200 dark:ring-gray-700">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.last_vacuum") %></p>
        <p class="<%= pgbus_health_number_css(verdict.vacuum) %>"><%= pgbus_duration(@health[:oldest_vacuum_ago_sec]) %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.oldest_vacuum_ago") %></p>
        <%= pgbus_health_words(verdict.vacuum) %>
      </div>

      <div class="rounded-lg bg-white dark:bg-gray-800 p-5 shadow ring-1 ring-gray-200 dark:ring-gray-700">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.mvcc_horizon") %></p>
        <p class="<%= pgbus_health_number_css(verdict.transaction) %>"><%= pgbus_duration(@health[:oldest_transaction_age_sec]) %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.oldest_open_txn") %></p>
        <%= pgbus_health_words(verdict.transaction) %>
      </div>
    </div>

    <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700">
      <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.headers.table") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.headers.kind") %></th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.headers.live") %></th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.headers.dead") %></th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.headers.bloat") %></th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.headers.last_vacuum") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @health[:tables].each do |table| %>
            <% bloat = Pgbus::Web::HealthVerdict.level(table[:bloat_ratio].to_f, Pgbus::Web::HealthVerdict::BLOAT_WARN, Pgbus::Web::HealthVerdict::BLOAT_CRITICAL) %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td data-label="<%= t("pgbus.dashboard.queue_health.headers.table") %>" class="px-4 py-3 text-sm font-mono text-gray-900 dark:text-white"><%= table[:table] %></td>
              <td data-label="<%= t("pgbus.dashboard.queue_health.headers.kind") %>" class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.queue_health.kinds.#{table[:kind]}") %></td>
              <td data-label="<%= t("pgbus.dashboard.queue_health.headers.live") %>" class="px-4 py-3 text-sm text-right text-gray-700 dark:text-gray-300"><%= pgbus_number(table[:live_tuples]) %></td>
              <td data-label="<%= t("pgbus.dashboard.queue_health.headers.dead") %>" class="px-4 py-3 text-sm text-right text-gray-700 dark:text-gray-300"><%= pgbus_number(table[:dead_tuples]) %></td>
              <td data-label="<%= t("pgbus.dashboard.queue_health.headers.bloat") %>" class="px-4 py-3 text-sm text-right <%= bloat == :ok ? 'text-gray-700 dark:text-gray-300' : bloat == :warn ? 'text-amber-700 dark:text-amber-300 font-semibold' : 'text-red-700 dark:text-red-300 font-semibold' %>"><%= pgbus_percent(table[:bloat_ratio]) %></td>
              <td data-label="<%= t("pgbus.dashboard.queue_health.headers.last_vacuum") %>" class="px-4 py-3 text-sm text-right text-gray-500 dark:text-gray-400"><%= pgbus_duration(table[:last_vacuum_ago_sec]) %></td>
            </tr>
          <% end %>
          <% if @health[:tables].empty? %>
            <%= render "pgbus/shared/empty_row", colspan: 6, message: t("pgbus.dashboard.queue_health.empty") %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</turbo-frame>
