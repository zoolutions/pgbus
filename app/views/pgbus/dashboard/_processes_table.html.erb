<turbo-frame id="dashboard-processes" data-auto-refresh data-src="<%= pgbus.root_path(frame: 'processes') %>">
  <div>
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("pgbus.dashboard.processes_table.title") %></h2>
    <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700">
      <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.processes_table.headers.kind") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.processes_table.headers.host") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.processes_table.headers.pid") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.processes_table.headers.status") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @processes.each do |process| %>
            <tr id="dashboard-process-<%= process[:id] %>">
              <td data-label="<%= t("pgbus.dashboard.processes_table.headers.kind") %>" class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-white"><%= process[:kind] %></td>
              <td data-label="<%= t("pgbus.dashboard.processes_table.headers.host") %>" class="px-4 py-3 text-sm lg:whitespace-nowrap text-gray-500 dark:text-gray-400"><%= process[:hostname] %></td>
              <td data-label="<%= t("pgbus.dashboard.processes_table.headers.pid") %>" class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= process[:pid] %></td>
              <td data-label="<%= t("pgbus.dashboard.processes_table.headers.status") %>" class="px-4 py-3 text-sm"><%= render "pgbus/processes/status", state: @process_states.fetch(process[:id]) %></td>
            </tr>
          <% end %>
          <% if @processes.empty? %>
            <%= render "pgbus/shared/empty_row", colspan: 4, message: t("pgbus.dashboard.processes_table.empty") %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</turbo-frame>
