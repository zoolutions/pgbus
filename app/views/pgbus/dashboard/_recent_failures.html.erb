<turbo-frame id="dashboard-failures" data-auto-refresh data-src="<%= pgbus.root_path(frame: 'failures') %>">
  <div>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white"><%= t("pgbus.dashboard.recent_failures.title") %></h2>
      <%= pgbus_link_to t("pgbus.dashboard.recent_failures.view_all"), pgbus.jobs_path(state: "retrying"), data: { turbo_frame: "_top" } %>
    </div>
    <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700">
      <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-900">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.recent_failures.headers.job") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.recent_failures.headers.queue") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.recent_failures.headers.error") %></th>
            <th class="px-4 py-3 text-right text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.recent_failures.headers.attempt") %></th>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.dashboard.recent_failures.headers.when") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          <% @recent_failures.each do |f| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td data-label="<%= t("pgbus.dashboard.recent_failures.headers.job") %>" class="px-4 py-3 text-sm">
                <%= pgbus_link_to pgbus_failure_job(f), pgbus.job_path(f["id"]), data: { turbo_frame: "_top" } %>
              </td>
              <td data-label="<%= t("pgbus.dashboard.recent_failures.headers.queue") %>" class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200"><%= f["queue_name"] %></td>
              <td data-label="<%= t("pgbus.dashboard.recent_failures.headers.error") %>" class="px-4 py-3 text-sm text-red-700 dark:text-red-300 truncate max-w-xs" title="<%= f["error_class"] %>: <%= f["error_message"] %>"><%= f["error_class"] %>: <%= truncate(f["error_message"].to_s, length: 60) %></td>
              <td data-label="<%= t("pgbus.dashboard.recent_failures.headers.attempt") %>" class="px-4 py-3 text-sm text-right text-gray-700 dark:text-gray-200"><%= pgbus_failure_attempt(f) %></td>
              <td data-label="<%= t("pgbus.dashboard.recent_failures.headers.when") %>" class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= pgbus_time(f["failed_at"]) %></td>
            </tr>
          <% end %>
          <% if @recent_failures.empty? %>
            <%= render "pgbus/shared/empty_row", colspan: 5, message: t("pgbus.dashboard.recent_failures.empty") %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</turbo-frame>
