<%# One pending event plus its expansion row (issue #494). Locals: row (a
    DataSource#event_rows hash), event (its EventState::Result), selectable,
    columns.
    The raw message is kept so a corrupt payload stays visible in the edit
    textarea and the full-JSON panel: pgbus_parse_message returns {} for
    unparseable JSON, which would hide exactly what the operator is repairing.
    Scalar JSON (numbers, arrays) is coerced to {} for hash access. %>
<% payload_raw = pgbus_parse_message(row[:payload]) %>
<% payload = payload_raw.is_a?(Hash) ? payload_raw : {} %>
<% parse_ok = row[:payload].blank? || payload_raw != {} || row[:payload].to_s.strip == "{}" %>
<% queue_row = row[:source] == "queue" %>
<% failed_id = row[:failed_event_id] %>
<tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50" data-event-row data-state="<%= event.state %>" data-msg-id="<%= row[:msg_id] %>">
  <% if selectable %>
    <td class="w-10 px-4 py-3 align-top">
      <% if queue_row %>
        <input type="checkbox" data-bulk-item data-pgbus-action="bulk-row-toggle"
               aria-label="<%= t("pgbus.helpers.bulk_select_row", id: row[:msg_id]) %>"
               class="h-4 w-4 rounded border-gray-300 text-indigo-600 dark:text-indigo-400 focus:ring-indigo-600 mt-1">
        <input type="hidden" name="messages[][queue_name]" value="<%= row[:queue_name] %>" form="bulk-discard-events-form" disabled>
        <input type="hidden" name="messages[][msg_id]" value="<%= row[:msg_id] %>" form="bulk-discard-events-form" disabled>
      <% end %>
    </td>
  <% end %>
  <td data-label="<%= t("pgbus.events.list.headers.id") %>" class="px-4 py-3 text-sm font-mono text-gray-900 dark:text-white align-top">
    <details data-job-toggle class="group">
      <summary class="cursor-pointer list-none text-indigo-600 hover:text-indigo-800 dark:hover:text-indigo-300 dark:text-indigo-400"><%= row[:msg_id] || row[:id] %></summary>
    </details>
  </td>
  <td data-label="<%= t("pgbus.events.list.headers.event") %>" class="px-4 py-3 text-sm align-top">
    <span class="block font-mono text-gray-900 dark:text-white"><%= pgbus_event_routing_key(row[:payload]) %></span>
    <span class="block text-xs font-mono text-gray-500 dark:text-gray-400"><%= payload["event_id"] || "—" %></span>
  </td>
  <td data-label="<%= t("pgbus.events.list.headers.handler") %>" class="px-4 py-3 text-sm align-top">
    <span class="block font-medium text-gray-900 dark:text-white"><%= row[:handler_class] || "—" %></span>
    <span class="block text-xs text-gray-500 dark:text-gray-400"><%= row[:queue_name] %></span>
  </td>
  <td data-label="<%= t("pgbus.events.list.headers.state") %>" class="px-4 py-3 text-sm align-top"><%= pgbus_event_state_badge(event.state) %></td>
  <td data-label="<%= t("pgbus.events.list.headers.attempts") %>" class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400 align-top"><%= pgbus_job_attempts(row, @state_context.jobs.max_retries) %></td>
  <td data-label="<%= t("pgbus.events.list.headers.reason") %>" class="px-4 py-3 text-sm text-gray-700 dark:text-gray-200 align-top" data-testid="event-reason">
    <%= pgbus_event_reason(event) %>
  </td>
  <td data-label="<%= t("pgbus.events.list.headers.actions") %>" class="px-4 py-3 text-sm text-right align-top">
    <div class="flex justify-end space-x-2">
      <% if queue_row %>
        <%# Marking a running event handled would race the handler still running it. %>
        <% unless event.state == "running" %>
          <%# handler_class is resolved server-side from the subscriber registry. %>
          <%= pgbus_button_to t("pgbus.events.list.mark_handled"),
                pgbus.mark_handled_event_path(row[:msg_id], queue_name: row[:queue_name]),
                method: :post, variant: :link, size: :sm, tone: :green,
                data: { turbo_confirm: t("pgbus.events.list.mark_handled_confirm"), turbo_frame: "_top" } %>
        <% end %>
        <%= pgbus_button_to t("pgbus.events.list.discard"),
              pgbus.discard_event_path(row[:msg_id], queue_name: row[:queue_name]),
              method: :post, variant: :link, size: :sm, tone: :red,
              data: { turbo_confirm: t("pgbus.events.list.discard_confirm"), turbo_frame: "_top" } %>
      <% elsif failed_id %>
        <%= pgbus_button_to t("pgbus.events.list.discard"), pgbus.discard_job_path(failed_id),
              method: :post, variant: :link, size: :sm, tone: :red,
              data: { turbo_confirm: t("pgbus.events.list.discard_failure_confirm"), turbo_frame: "_top" } %>
      <% end %>
    </div>
  </td>
</tr>
<tr class="pgbus-job-detail" data-event-detail>
  <td colspan="<%= columns %>" class="px-4 pb-4 bg-gray-50 dark:bg-gray-900 border-t border-gray-100 dark:border-gray-700">
    <div class="flex items-center justify-between mt-3 mb-3">
      <span class="text-xs font-mono text-gray-500 dark:text-gray-400"><%= t("pgbus.events.list.event_id") %> <%= payload["event_id"] || "—" %></span>
      <div class="flex items-center space-x-2">
        <% if failed_id %>
          <%= pgbus_link_to t("pgbus.events.list.view_failure"), pgbus.job_path(failed_id),
                variant: :link, size: :sm, data: { turbo_frame: "_top" } %>
        <% end %>
        <% if queue_row %>
          <details class="relative inline-block">
            <summary class="<%= pgbus_button_classes(:warning, :sm, extra: "cursor-pointer list-none") %>">
              <%= t("pgbus.events.list.reroute") %>
            </summary>
            <div class="absolute right-0 z-10 mt-1 w-64 rounded-md bg-white dark:bg-gray-800 shadow-lg ring-1 ring-gray-200 dark:ring-gray-700 p-2">
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-2"><%= t("pgbus.events.list.reroute_label") %></p>
              <% @subscribers.each do |s| %>
                <% next if s[:physical_queue_name] == row[:queue_name] %>
                <%= pgbus_button_to s[:handler_class],
                      pgbus.reroute_event_path(row[:msg_id], queue_name: row[:queue_name], target_queue: s[:physical_queue_name]),
                      method: :post, variant: :menu, size: :sm,
                      data: { turbo_confirm: t("pgbus.events.list.reroute_confirm"), turbo_frame: "_top" } %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
    <% if row[:error_class] %>
      <p class="mb-3 text-xs text-red-700 dark:text-red-400"><span class="font-medium"><%= row[:error_class] %></span>: <%= truncate(row[:error_message].to_s, length: 300) %></p>
    <% end %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-3">
      <div>
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.events.list.payload") %></span>
        <pre class="text-xs text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 rounded p-2 mt-1 overflow-x-auto max-h-40"><%= parse_ok ? (JSON.pretty_generate(payload["payload"] || payload_raw) rescue "—") : row[:payload] %></pre>
      </div>
      <div>
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.events.list.metadata") %></span>
        <div class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 rounded p-2 mt-1 space-y-1">
          <% unless row[:read_ct].nil? %><p><strong><%= t("pgbus.events.list.metadata_labels.read_count") %></strong> <%= row[:read_ct] %></p><% end %>
          <% if payload["published_at"] %><p><strong><%= t("pgbus.events.list.metadata_labels.published") %></strong> <%= pgbus_timestamp(payload["published_at"]) %></p><% end %>
          <% if row[:enqueued_at] %><p><strong><%= t("pgbus.events.list.metadata_labels.enqueued") %></strong> <%= pgbus_timestamp(row[:enqueued_at]) %></p><% end %>
          <% if row[:vt] %><p><strong><%= t("pgbus.events.list.metadata_labels.visible_at") %></strong> <%= pgbus_timestamp(row[:vt]) %></p><% end %>
          <% if row[:last_read_at] %><p><strong><%= t("pgbus.events.list.metadata_labels.last_read") %></strong> <%= pgbus_timestamp(row[:last_read_at]) %></p><% end %>
        </div>
      </div>
    </div>
    <%# Persisted Current attributes (issue #431) %>
    <% if (event_context = pgbus_job_context(row[:payload])) %>
      <div class="mb-3" data-testid="job-context">
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.events.list.context") %></span>
        <div class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 rounded p-2 mt-1 space-y-2">
          <% event_context.each do |klass_name, attrs| %>
            <div>
              <p class="font-semibold text-gray-700 dark:text-gray-300 font-mono"><%= klass_name %></p>
              <dl class="grid grid-cols-1 gap-x-4 gap-y-0.5 sm:grid-cols-2">
                <% attrs.each do |name, value| %>
                  <div class="flex gap-2">
                    <dt class="text-gray-500 dark:text-gray-400 font-mono"><%= name %></dt>
                    <dd class="text-gray-900 dark:text-white font-mono break-all"><%= value %></dd>
                  </div>
                <% end %>
              </dl>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if queue_row %>
      <details class="mt-2">
        <summary class="text-xs font-medium text-indigo-600 dark:text-indigo-400 cursor-pointer hover:text-indigo-800 dark:hover:text-indigo-300"><%= t("pgbus.events.list.edit_payload") %></summary>
        <div class="mt-2 p-3 bg-white dark:bg-gray-800 rounded ring-1 ring-gray-200 dark:ring-gray-700">
          <%= form_with url: pgbus.edit_payload_event_path(row[:msg_id]), method: :post, local: true, data: { turbo_frame: "_top" } do |f| %>
            <%= hidden_field_tag :queue_name, row[:queue_name], id: nil %>
            <label for="event-payload-<%= row[:msg_id] %>" class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= t("pgbus.events.list.edit_payload_label") %></label>
            <textarea id="event-payload-<%= row[:msg_id] %>" name="payload" rows="6"
                      class="mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-900 dark:text-white text-xs font-mono shadow-sm focus:border-indigo-500 focus:ring-indigo-500"><%= parse_ok ? (JSON.pretty_generate(payload_raw) rescue row[:payload]) : row[:payload] %></textarea>
            <div class="mt-2 flex justify-end">
              <%= pgbus_button_tag t("pgbus.events.list.edit_payload"), variant: :primary, size: :sm,
                    confirm: t("pgbus.events.list.edit_payload_confirm") %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
    <details class="mt-2">
      <summary class="text-xs font-medium text-gray-500 dark:text-gray-400 cursor-pointer hover:text-gray-700 dark:hover:text-gray-200"><%= t("pgbus.events.list.full_json_payload") %></summary>
      <pre class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 rounded p-2 mt-1 overflow-x-auto max-h-96"><%= parse_ok ? (JSON.pretty_generate(payload_raw) rescue row[:payload]) : row[:payload] %></pre>
    </details>
    <% if row[:headers] %>
      <details class="mt-2">
        <summary class="text-xs font-medium text-gray-500 dark:text-gray-400 cursor-pointer hover:text-gray-700 dark:hover:text-gray-200"><%= t("pgbus.events.list.headers_section") %></summary>
        <pre class="text-xs text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-800 rounded p-2 mt-1 overflow-x-auto"><%= JSON.pretty_generate(JSON.parse(row[:headers])) rescue row[:headers] %></pre>
      </details>
    <% end %>
  </td>
</tr>
