<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("pgbus.events.index.title") %></h1>
</div>

<%# Registered subscribers, each with whether a running consumer drains it. %>
<div class="mb-8">
  <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("pgbus.events.index.subscribers_title") %></h2>
  <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 shadow ring-1 ring-gray-200 dark:ring-gray-700" data-testid="subscribers">
    <table class="pgbus-table min-w-full divide-y divide-gray-200 dark:divide-gray-700">
      <thead class="bg-gray-50 dark:bg-gray-900">
        <tr>
          <% %w[pattern handler queue consumer pending].each do |header| %>
            <th class="px-4 py-3 text-left text-xs font-medium uppercase text-gray-500 dark:text-gray-400"><%= t("pgbus.events.index.subscribers_headers.#{header}") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% covered = @state_context.covered_queues %>
        <% @subscribers.each do |s| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
            <td data-label="<%= t("pgbus.events.index.subscribers_headers.pattern") %>" class="px-4 py-3 text-sm font-mono text-indigo-700 dark:text-indigo-300"><%= s[:pattern] %></td>
            <td data-label="<%= t("pgbus.events.index.subscribers_headers.handler") %>" class="px-4 py-3 text-sm text-gray-900 dark:text-white"><%= s[:handler_class] %></td>
            <td data-label="<%= t("pgbus.events.index.subscribers_headers.queue") %>" class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400"><%= s[:queue_name] %></td>
            <td data-label="<%= t("pgbus.events.index.subscribers_headers.consumer") %>" class="px-4 py-3 text-sm">
              <% if covered.nil? %>
                <span class="text-gray-600 dark:text-gray-300"><%= t("pgbus.events.index.subscribers.unknown") %></span>
              <% elsif covered.include?(s[:physical_queue_name]) %>
                <span class="text-green-700 dark:text-green-400"><%= t("pgbus.events.index.subscribers.covered") %></span>
              <% else %>
                <span class="text-yellow-800 dark:text-yellow-300"><%= t("pgbus.events.index.subscribers.uncovered") %></span>
              <% end %>
            </td>
            <td data-label="<%= t("pgbus.events.index.subscribers_headers.pending") %>" class="px-4 py-3 text-sm">
              <%= pgbus_link_to t("pgbus.events.index.subscribers.view_pending"), pgbus.events_path(queue: s[:physical_queue_name]),
                    variant: :link, size: :sm %>
            </td>
          </tr>
        <% end %>
        <% if @subscribers.empty? %>
          <%= render "pgbus/shared/empty_row", colspan: 5, message: t("pgbus.events.index.subscribers_empty") %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mb-8">
  <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("pgbus.events.index.pending_title") %></h2>
  <%= render "pgbus/events/tabs" %>
  <%= render "pgbus/events/list" %>
</div>

<div>
  <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("pgbus.events.index.processed_title") %></h2>
  <%= render "pgbus/events/processed_table" %>
</div>
