class UpgradePgmqToV<%= target_version_slug.camelize %> < ActiveRecord::Migration<%= migration_version %>
  def up
    # Drop existing PGMQ functions and types so they can be re-created
    # at the new version. Tables (pgmq.meta, queue tables) are preserved.
    execute Pgbus::PgmqSchema.drop_pgmq_functions_sql

    # Re-create all PGMQ functions and types at the new version.
    # This uses the vendored SQL which doesn't require the pgmq extension.
    execute Pgbus::PgmqSchema.install_sql("<%= target_version %>")

    # Apply the table fixups upstream ships for every hop between the
    # version this database records and the target. Dropping and re-creating
    # the functions cannot carry a change to an existing TABLE (1.13.0 moves
    # partitioned queues' msg_id to GENERATED BY DEFAULT), so those ride
    # here. Runs after install_sql because the fixups call
    # pgmq.format_table_name, which the drop step removed. Each fixup is
    # idempotent, so an install with no recorded version gets them all.
    fixups = Pgbus::PgmqSchema.fixups_sql(after: installed_pgmq_version, upto: "<%= target_version %>")
    execute fixups unless fixups.empty?

    # Re-install the per-queue NOTIFY insert triggers the function drop
    # cascaded away (pgmq.notify_insert_throttle records which queues had
    # them and at what throttle; enable_notify_insert is idempotent).
    # Without this, NOTIFY-gated wakeups silently die and workers fall back
    # to polling until each queue is re-ensured by a process restart.
    execute Pgbus::PgmqSchema.reinstall_notify_triggers_sql

    # Record the upgrade
    execute <<~SQL
      CREATE TABLE IF NOT EXISTS pgbus_pgmq_schema_versions (
        id SERIAL PRIMARY KEY,
        version VARCHAR NOT NULL,
        installed_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL,
        install_method VARCHAR NOT NULL DEFAULT 'embedded'
      );

      INSERT INTO pgbus_pgmq_schema_versions (version, install_method)
      VALUES ('<%= target_version %>', 'upgrade');
    SQL
  end

  def down
    raise ActiveRecord::IrreversibleMigration,
      "PGMQ schema downgrade is not supported. " \
      "Restore from a database backup if needed."
  end

  private

  # The version this database last recorded, or nil when it has never been
  # tracked (a pre-tracking install, or one bootstrapped by hand).
  def installed_pgmq_version
    return nil unless connection.table_exists?("pgbus_pgmq_schema_versions")

    connection.select_value(
      "SELECT version FROM pgbus_pgmq_schema_versions ORDER BY installed_at DESC LIMIT 1"
    )
  end
end
